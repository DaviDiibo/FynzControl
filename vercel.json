{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "bash ./scripts/vercel-ignore.sh",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
