{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ControlFynz",
  "version": "1.0.4",
  "identifier": "com.controlfynz.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "npx expo start --web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "ControlFynz",
        "width": 960,
        "height": 780,
        "minWidth": 460,
        "minHeight": 680,
        "maxWidth": 1280,
        "maxHeight": 980,
        "center": true,
        "devtools": true,
        "backgroundColor": "#121212",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": "v1Compatible",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCNTJCQkIyNDEwNzc3NDMKUldSRGR3ZEJzcnRTT3hyQy9jRmpnNHNEUTg4T0lWcEJrNTdtTWQ0b3ZlZVNMbzE4TWtwNCswd3kK",
      "endpoints": [
        "https://github.com/DaviDiibo/FynzControl/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
