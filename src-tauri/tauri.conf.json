{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ControlFynz",
  "version": "1.0.0",
  "identifier": "com.controlfynz.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8081",
    "beforeDevCommand": "npx expo start --web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "title": "ControlFynz",
        "width": 460,
        "height": 860,
        "minWidth": 400,
        "minHeight": 680,
        "maxWidth": 580,
        "maxHeight": 980,
        "center": true,
        "backgroundColor": "#121212",
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
